generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id        String       @id @default(uuid())
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  decks     Deck[]
  games     GamePlayer[]
  pods      PlayerPod[]
  invites   PodInvite[]  @relation("InvitedPlayer")
  sentInvites PodInvite[] @relation("InvitingSender")
}

model Deck {
  id            String     @id @default(uuid())
  name          String
  commanderName String
  description   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  playerId      String?    // Can be null for guest decks
  player        Player?    @relation(fields: [playerId], references: [id], onDelete: SetNull)
  games         GameDeck[]
  isGuest       Boolean    @default(false)
  guestName     String?    // Name for guest decks
}

model Pod {
  id          String      @id @default(uuid())
  name        String
  description String?
  isPublic    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  games       Game[]
  players     PlayerPod[]
  invites     PodInvite[]
}

enum PodRole {
  ADMIN
  MEMBER
}

model PlayerPod {
  id        String   @id @default(uuid())
  playerId  String
  podId     String
  role      PodRole  @default(MEMBER)
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  pod       Pod      @relation(fields: [podId], references: [id], onDelete: Cascade)

  @@unique([playerId, podId])
}

model PodInvite {
  id         String     @id @default(uuid())
  podId      String
  playerId   String
  senderId   String
  status     InviteStatus @default(PENDING)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  pod        Pod        @relation(fields: [podId], references: [id], onDelete: Cascade)
  player     Player     @relation("InvitedPlayer", fields: [playerId], references: [id], onDelete: Cascade)
  sender     Player     @relation("InvitingSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([podId, playerId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Game {
  id        String       @id @default(uuid())
  playedAt  DateTime     @default(now())
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  podId     String
  createdById String?    // Track who created the game
  pod       Pod          @relation(fields: [podId], references: [id], onDelete: Cascade)
  decks     GameDeck[]
  players   GamePlayer[]
}

model GamePlayer {
  id       String @id @default(uuid())
  gameId   String
  playerId String
  game     Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([gameId, playerId])
}

model GameDeck {
  id       String  @id @default(uuid())
  gameId   String
  deckId   String
  playerId String? // Player who used this deck (might not be the owner)
  isWinner Boolean @default(false)
  deck     Deck    @relation(fields: [deckId], references: [id], onDelete: Cascade)
  game     Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, deckId])
}
